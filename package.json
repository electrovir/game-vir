{
    "name": "@game-vir/mono-repo",
    "version": "14.8.0",
    "private": true,
    "homepage": "https://github.com/electrovir/game-vir",
    "bugs": {
        "url": "https://github.com/electrovir/game-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/game-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run compile && mono-vir for-each-async npm run build && npm run script copy-to-dist",
        "compile": "virmator compile",
        "docs": "npm run docs --workspaces --if-present",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "script": "npm run execute --workspace @game-vir/scripts",
        "start": "npm start --workspace @game-vir/book",
        "test": "mono-vir for-each-async npm run test",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint,build \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\" \"npm run build\"",
        "test:deps": "virmator deps check",
        "test:docs": "npm run --workspaces --if-present test:docs",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "mono-vir for-each-async npm run test:update"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.27.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "cspell": "^9.0.1",
        "dependency-cruiser": "^16.10.2",
        "esbuild": "^0.25.4",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsdoc": "^50.6.17",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "mono-vir": "^2.0.6",
        "npm-check-updates": "^18.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.13",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.5",
        "typescript-eslint": "^8.32.1",
        "virmator": "^13.15.1"
    },
    "engines": {
        "node": ">=22"
    }
}
