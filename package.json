{
    "name": "@game-vir/mono-repo",
    "version": "5.3.0",
    "private": true,
    "license": "(MIT or CC0 1.0)",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run compile && mono-vir for-each-async npm run build && npm run script copy-to-dist",
        "compile": "mono-vir for-each tsc -b --pretty",
        "format": "virmator format",
        "publish": "virmator publish \"npm run test:all\"",
        "script": "npm run execute --workspace @game-vir/scripts",
        "start": "npm run start --workspace @game-vir/book",
        "test": "mono-vir for-each-async npm run test:all",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\"",
        "test:deps": "virmator deps check",
        "test:docs": "npm run --workspaces --if-present test:docs",
        "test:format": "virmator format check",
        "test:spelling": "virmator spellcheck",
        "test:types": "npm run compile"
    },
    "devDependencies": {
        "cspell": "^8.10.4",
        "dependency-cruiser": "^16.3.5",
        "esbuild": "^0.23.0",
        "mono-vir": "^1.0.1",
        "npm-check-updates": "~16.12.3",
        "prettier": "^3.3.2",
        "prettier-plugin-interpolated-html-tags": "^1.0.5",
        "prettier-plugin-jsdoc": "^1.3.0",
        "prettier-plugin-multiline-arrays": "^3.0.6",
        "prettier-plugin-organize-imports": "^4.0.0",
        "prettier-plugin-packagejson": "^2.5.0",
        "prettier-plugin-sort-json": "^4.0.0",
        "prettier-plugin-toml": "^2.0.1",
        "virmator": "^12.0.2"
    }
}
